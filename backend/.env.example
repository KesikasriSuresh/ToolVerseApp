# ---- Environment -------------------------------------------------------------
# "development" enables the dev OTP provider and Swagger docs. Use "production" when deployed.
ENVIRONMENT=development

# ---- MongoDB Atlas -----------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=toolverse

# ---- JWT (REQUIRED, >= 32 chars; the server refuses to start otherwise) --------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Phone OTP ---------------------------------------------------------------
# twilio_verify = real SMS (needs the three TWILIO_* values). dev = static code, local use only.
SMS_PROVIDER=dev
SMS_DEV_CODE=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Behaviour flags ---------------------------------------------------------
ALLOW_ANONYMOUS_AUTH=true
ALLOW_CLIENT_SYSTEM_MESSAGES=true

# ---- Push notifications (FCM via firebase-admin) -------------------------------
# Path to a Firebase service-account JSON stored OUTSIDE git. Empty = push disabled.
FIREBASE_CREDENTIALS_FILE=

# ---- CORS (comma-separated origins; "*" only allowed in development) -----------
CORS_ORIGINS=*
